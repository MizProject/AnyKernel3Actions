{
  "kernel.string": "ExampleKernel {kernel_version} ({short_sha})",
  "do.devicecheck": 1,
  "do.modules": 0,
  "do.systemless": 1,
  "do.cleanup": 1,
  "do.cleanuponabort": 0,
  "device.names": ["sweet", "sweetin"],
  "supported.versions": "13 - 15",
  "supported.patchlevels": "2024-01 -",
  "block": "/dev/block/bootdevice/by-name/boot",
  "is-slot-device": "1",
  "ramdisk-compression": "auto",
  "patch-vbmeta-flag": "auto",
  "install-mode": "dump_write",
  "strip-example-patches": true
}
